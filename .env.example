# ============================================================
# Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# For Netlify deployment, set these in:
#   Netlify Dashboard > Site > Environment Variables
# ============================================================

# Pinecone - https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=portfolio

# Google AI (Gemini) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# OpenRouter (optional) - https://openrouter.ai/keys
# When set, chat answers are generated through OpenRouter (Gemini models);
# GEMINI_API_KEY is still used for embeddings.
OPEN_ROUTER_API_KEY=your_openrouter_api_key
